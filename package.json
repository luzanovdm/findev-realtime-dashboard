{
  "name": "findev-realtime-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "asc assembly/index.ts --target release",
    "prestart": "npm run build:wasm",
    "start": "ng serve --host 127.0.0.1 --open=false",
    "dev": "npm start",
    "prebuild": "npm run build:wasm",
    "build": "ng build",
    "prewatch": "npm run build:wasm",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "ng test --watch=false",
    "test:watch": "ng test",
    "test:smoke": "npm run build && node --test tests/producer-worker.test.mjs tests/wasm-abi.test.mjs tests/wasm-generator.test.mjs",
    "perf:soak": "npm run build && node scripts/performance-soak.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged",
    "commit": "commit",
    "commitlint": "commitlint",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/manrope": "5.3.0",
    "@taiga-ui/cdk": "5.29.0",
    "@taiga-ui/core": "5.29.0",
    "@taiga-ui/icons": "5.29.0",
    "@taiga-ui/kit": "5.29.0",
    "@taiga-ui/styles": "5.29.0",
    "decimal.js": "10.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/prompt-cli": "21.2.4",
    "assemblyscript": "0.28.20",
    "husky": "9.1.7",
    "jsdom": "^30.0.0",
    "less": "4.9.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.3"
    }
  }
}
